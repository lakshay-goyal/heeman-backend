// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String           @id
  name          String
  email         String           @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String? // For admin/user roles
  sessions      Session[]
  accounts      Account[]
  coupons       Coupon[]         @relation("UserCoupons")
  wishlist      Product[]        @relation("UserWishlist")
  enquiries     ProductEnquiry[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Product {
  id              String         @id @default(uuid())
  productId       String         @unique
  name            String
  series          String?
  description     String
  price           Float
  images          ProductImage[]
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  colors          String[]
  aboutItem       String
  specialFeatures String[]
  tags            String[]
  isTopProduct    Boolean        @default(false)
  topProductRank  Int?

  // Specs
  productMaterial    String?
  productDimension   String?
  material           String?
  weight             String?
  height             String?
  styleAndPatterns   String?
  includedComponents String[]
  careInstructions   String?

  // Coupons
  coupons Coupon[] @relation("ProductCoupons")

  // Wishlist
  wishlistedBy User[] @relation("UserWishlist")

  // Enquiries
  enquiryItems ProductEnquiryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductImage {
  id    String  @id @default(uuid())
  url   String
  color String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Coupon {
  id             String       @id @default(uuid())
  code           String       @unique
  discountType   DiscountType
  discountValue  Float
  isActive       Boolean      @default(true)
  isVisible      Boolean      @default(true) // Public vs Private coupon
  validFrom      DateTime     @default(now())
  validUntil     DateTime?
  usageLimit     Int?
  usedCount      Int          @default(0)
  isGlobal       Boolean      @default(false)
  minOrderAmount Float? // Minimum cart value required to unlock
  minItemCount   Int? // Minimum number of items required to unlock

  // Products associated with this coupon
  // If empty, it applies to all products (logical check in code)
  products Product[] @relation("ProductCoupons")

  // Target users associated with this coupon
  // If empty, it applies to any user (logical check in code)
  users User[] @relation("UserCoupons")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Single-row settings table — always upsert on the fixed id "global"
model BillingConfig {
  id                    String   @id @default("global")
  gstPercent            Float    @default(18)
  gstLabel              String   @default("GST")
  shippingCharge        Float    @default(150)
  freeShippingThreshold Float    @default(5000)
  shippingLabel         String   @default("Delivery Charges")
  handlingCharge        Float    @default(0)
  handlingLabel         String   @default("Production Handling")
  extraCharges          Json     @default("[]") // [{label, amount, percent}]
  updatedAt             DateTime @updatedAt

  @@map("billing_config")
}

model CustomEnquiry {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  images    String[] // Supabase public URLs
  status    EnquiryStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("custom_enquiry")
}

enum EnquiryStatus {
  PENDING
  REVIEWED
  COMPLETED
}

model EnquiryVerification {
  id           String              @id @default(uuid())
  channel      VerificationChannel
  email        String?
  phone        String?
  otpHash      String?
  tokenHash    String?             @unique
  status       VerificationStatus  @default(PENDING)
  attemptCount Int                 @default(0)
  expiresAt    DateTime
  verifiedAt   DateTime?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  enquiries ProductEnquiry[]

  @@index([email, channel, status])
  @@index([phone, channel, status])
  @@map("enquiry_verification")
}

model ProductEnquiry {
  id                       String                     @id @default(uuid())
  type                     EnquiryType                @default(PRODUCT)
  userId                   String?
  user                     User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  verificationId           String?
  verification             EnquiryVerification?       @relation(fields: [verificationId], references: [id], onDelete: SetNull)
  name                     String
  email                    String
  phone                    String
  message                  String?
  sourcePage               String?
  status                   ProductEnquiryStatus       @default(NEW)
  whatsappStatus           WhatsAppConversationStatus @default(NOT_SENT)
  whatsappConsent          Boolean                    @default(false)
  whatsappConsentText      String?
  whatsappConsentAt        DateTime?
  whatsappConsentIp        String?
  whatsappConsentUserAgent String?
  verificationTokenHash    String?
  emailVerifiedAt          DateTime?
  phoneVerifiedAt          DateTime?
  referenceImages          String[]
  items                    ProductEnquiryItem[]
  whatsappMessages         WhatsAppMessage[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@index([status])
  @@index([whatsappStatus])
  @@index([email])
  @@index([phone])
  @@map("product_enquiry")
}

model ProductEnquiryItem {
  id              String         @id @default(uuid())
  enquiryId       String
  enquiry         ProductEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName     String
  productPrice    Float?
  quantity        Int            @default(1)
  productImage    String?
  productCategory String?
  createdAt       DateTime       @default(now())

  @@index([enquiryId])
  @@index([productId])
  @@map("product_enquiry_item")
}

model WhatsAppMessage {
  id                String                      @id @default(uuid())
  enquiryId         String?
  enquiry           ProductEnquiry?             @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  providerMessageId String?                     @unique
  phone             String
  direction         WhatsAppMessageDirection
  status            WhatsAppConversationStatus?
  body              String?
  raw               Json?
  createdAt         DateTime                    @default(now())

  @@index([enquiryId])
  @@index([phone])
  @@map("whatsapp_message")
}

enum VerificationChannel {
  EMAIL
  PHONE
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

enum EnquiryType {
  PRODUCT
  CUSTOM
}

enum ProductEnquiryStatus {
  NEW
  VERIFIED
  WHATSAPP_SENT
  REPLIED
  QUOTED
  FOLLOW_UP
  CLOSED
  SPAM
}

enum WhatsAppConversationStatus {
  NOT_SENT
  QUEUED
  SENT
  DELIVERED
  READ
  REPLIED
  FAILED
}

enum WhatsAppMessageDirection {
  OUTBOUND
  INBOUND
  STATUS
}
