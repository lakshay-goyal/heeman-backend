
# Connect to Supabase via connection pooling
DATABASE_URL="[YOUR-DATABASE-URL]"

# Direct (non-pooled) connection to the database. Used only for `prisma migrate deploy`/`generate`,
# since PgBouncer's transaction pooler (port 6543) doesn't support the advisory locks Prisma needs.
DIRECT_URL="[YOUR-DIRECT-DATABASE-URL]"

BETTER_AUTH_SECRET="[YOUR-BETTER-AUTH-SECRET]"
BETTER_AUTH_URL="http://localhost:8000"
ADMIN_EMAIL="[ADMIN-EMAIL]"
ADMIN_PASSWORD="[ADMIN-PASSWORD]"

PORT= 8000
FRONTEND_URL= "http://localhost:5173"
ADMIN_URL= "http://localhost:3000"


SMTP_HOST= "smtp.gmail.com"
SMTP_PORT= 587
SMTP_USER= "your-email@gmail.com"
SMTP_PASS= "your-app-password"
SMTP_FROM= "Heeman <no-reply@heeman.com>"

# Supabase project
SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_KEY"
SUPABASE_JWKS_URL="YOUR_SUPABASE_PROJECT_URL/auth/v1/.well-known/jwks.json"
SUPABASE_BUCKET="heeman-bucket"

# Supabase Storage S3-compatible access (optional; only needed for direct S3 protocol access)
SUPABASE_S3_ACCESS_KEY_ID="YOUR_S3_ACCESS_KEY_ID"
SUPABASE_S3_SECRET_ACCESS_KEY="YOUR_S3_SECRET_ACCESS_KEY"
SUPABASE_S3_REGION="ap-south-1"

# MSG91 OTP (SMS Verification)
MSG91_AUTH_KEY= "YOUR_MSG91_AUTH_KEY"
MSG91_TEMPLATE_ID= "YOUR_MSG91_TEMPLATE_ID"

# Enquiry verification token signing. Defaults to BETTER_AUTH_SECRET if omitted.
VERIFICATION_TOKEN_SECRET="YOUR-LONG-RANDOM-SECRET"

# WhatsApp Cloud API (optional in local dev; leads queue when missing)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="enquiry_received"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_GRAPH_API_VERSION="v22.0"
