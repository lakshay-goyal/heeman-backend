
# Connect to Supabase via connection pooling
DATABASE_URL="[YOUR-DATABASE-URL]"

# Direct connection to the database. Used for migrations
BETTER_AUTH_SECRET="[YOUR-BETTER-AUTH-SECRET]"
BETTER_AUTH_URL="http://localhost:8000"
ADMIN_EMAIL="[ADMIN-EMAIL]"
ADMIN_PASSWORD="[ADMIN-PASSWORD]"

PORT= 8000
FRONTEND_URL= "http://localhost:5173"
ADMIN_URL= "http://localhost:3000"


SMTP_HOST= "smtp.gmail.com"
SMTP_PORT= 587
SMTP_USER= "your-email@gmail.com"
SMTP_PASS= "your-app-password"
SMTP_FROM= "Heeman <no-reply@heeman.com>"

# Supabase Storage Configuration
SUPABASE_URL= "YOUR_SUPABASE_PROJECT_URL"
SUPABASE_KEY= "YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_BUCKET= "heeman-bucket"

# MSG91 OTP (SMS Verification)
MSG91_AUTH_KEY= "YOUR_MSG91_AUTH_KEY"
MSG91_TEMPLATE_ID= "YOUR_MSG91_TEMPLATE_ID"

# Enquiry verification token signing. Defaults to BETTER_AUTH_SECRET if omitted.
VERIFICATION_TOKEN_SECRET="YOUR-LONG-RANDOM-SECRET"

# WhatsApp Cloud API (optional in local dev; leads queue when missing)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME="enquiry_received"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_GRAPH_API_VERSION="v22.0"
